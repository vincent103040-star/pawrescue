# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_PASSWORD: The administrator ("Admin") password. There is no default any
# more -- this used to seed "0000", which meant every copy of this project that
# never changed it had a four-digit admin login documented in the repository.
# Leave this unset and the server generates a strong random password on first
# run and prints it to the console once; set it here and that value is used
# instead. Changing it later only takes effect on a database that has no admin
# account yet -- after that, change the password from the app's settings page.
ADMIN_PASSWORD=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LINE_CHANNEL_ACCESS_TOKEN: Required for real LINE push notifications via the Messaging API.
# Create a "Messaging API" channel at https://developers.line.biz/console (free) and
# issue a long-lived channel access token from the channel's "Messaging API" settings tab.
# Without this set, /api/line/push responds with a harmless simulated success.
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token_here"

# LINE_CHANNEL_SECRET: The same "Messaging API" channel's Channel secret (Basic settings
# tab, not the Login channel's secret). Used to verify the x-line-signature header on
# incoming webhook calls so /api/line/webhook only trusts requests really sent by LINE.
# Register this app's public URL + "/api/line/webhook" as the channel's Webhook URL.
# Without this set, signature verification is skipped (fine for local testing only).
LINE_CHANNEL_SECRET="your_line_messaging_api_channel_secret_here"

# LINE Login: Required to link a volunteer's real LINE userId so individual (non-broadcast)
# push notifications can actually be targeted at them. Create a separate "LINE Login"
# channel (not Messaging API) under the same Provider at https://developers.line.biz/console,
# set its Callback URL to http://localhost:3000/api/auth/line-callback, then copy the
# Channel ID and Channel secret from its Basic settings tab.
LINE_LOGIN_CHANNEL_ID="your_line_login_channel_id_here"
LINE_LOGIN_CHANNEL_SECRET="your_line_login_channel_secret_here"
# VITE_LINE_LOGIN_CHANNEL_ID: same Channel ID as above, exposed to the frontend to build
# the LINE authorize URL (Channel ID is not secret; only Channel secret is).
VITE_LINE_LOGIN_CHANNEL_ID="your_line_login_channel_id_here"

# VITE_LIFF_ID: LIFF app ID so the app can detect when it's opened inside LINE's
# in-app browser and prefill the applicant's real LINE name + userId instead of
# asking them to type it. Create a LIFF app under the same LINE Login channel at
# https://developers.line.biz/console (channel's "LIFF" tab > Add), Endpoint URL
# = this app's public HTTPS URL. Optional -- everything works without it, just
# without the LINE auto-fill.
VITE_LIFF_ID="1234567890-AbCdEfGh"

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID for real "Sign in with Google"
# + reading the account's Google-verified phone number via the People API.
# Get this from https://console.cloud.google.com/apis/credentials (free, no billing needed
# in Testing publishing status — just add your own email as a test user on the OAuth
# consent screen, and enable the "People API" in APIs & Services > Library).
VITE_GOOGLE_CLIENT_ID="xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
